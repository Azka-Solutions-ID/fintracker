{
  "name": "sidp-keuangan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:umkm": "bun --cwd apps/umkm run dev",
    "dev:pekerja": "bun --cwd apps/pekerja run dev",
    "dev:api": "bun --cwd packages/api run dev",
    "build": "bun --cwd packages/api run build && bun --cwd apps/umkm run build && bun --cwd apps/pekerja run build",
    "test": "bun test packages",
    "check:tokens": "bun packages/tokens/check-contrast.ts"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.2.21"
}
